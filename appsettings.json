{
  "Platform": {
    "Name": "AI Engineering Platform",
    "Environment": "Development",
    "Stack": {
      "Backend": ".NET 10",
      "Frontend": ["TypeScript", "React", "Angular"],
      "Containerization": "Docker"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agents": {
    "Enabled": [
      "architect",
      "developer",
      "tester",
      "code-reviewer",
      "security-reviewer",
      "devops",
      "documentation"
    ],
    "Governance": {
      "AutonomyLevel": "4-D",
      "RequiresHumanApproval": [
        "git-push-remote",
        "pull-request-merge",
        "database-migration",
        "secrets-or-env-changes",
        "environment-deployment"
      ]
    }
  },
  "OpenSpec": {
    "SpecsPath": "openspec/specs/"
  }
}
